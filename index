                            <label class="flex items-center space-x-2 p-2 rounded-lg border bg-white hover:bg-amber-50 cursor-pointer">
                                <input type="radio" name="kq20" value="A" class="text-amber-600">
                                <span>A. Paleolitikum</span>
                            </label>
                            <label class="flex items-center space-x-2 p-2 rounded-lg border bg-white hover:bg-amber-50 cursor-pointer">
                                <input type="radio" name="kq20" value="B" required class="text-amber-600">
                                <span>B. Mesolitikum</span>
                            </label>
                            <label class="flex items-center space-x-2 p-2 rounded-lg border bg-white hover:bg-amber-50 cursor-pointer">
                                <input type="radio" name="kq20" value="C" class="text-amber-600">
                                <span>C. Neolitikum</span>
                            </label>
                            <label class="flex items-center space-x-2 p-2 rounded-lg border bg-white hover:bg-amber-50 cursor-pointer">
                                <input type="radio" name="kq20" value="D" class="text-amber-600">
                                <span>D. Perundagian</span>
                            </label>
                        </div>
                    </div>

                    <div class="pt-4">
                        <button type="submit" id="btnSubmitKuis" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold py-3.5 px-6 rounded-xl shadow-lg transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>Selesaikan 20 Soal Kuis & Simpan Nilai Akhir</span>
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-amber-950 text-amber-300 border-t border-amber-900 py-6 mt-12 text-center text-xs">
        <div class="max-w-7xl mx-auto px-4">
            <p>© 2026 HistoriEdu Kelas X - Media Pembelajaran Sejarah Interaktif</p>
            <p class="mt-1 text-amber-400/60">Tersambung langsung dengan Sistem Penilaian Google Sheets & Apps Script.</p>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Apps Script Target Web App URL
        const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycby_xlvWii9sD9zDYlK9zjnMU3-gp2sXJdGRHjyviCLVJN86Qz0ZPJyUupMWOMAUbLtz/exec";

        // Global User State
        let currentUser = {
            nama: "",
            kelas: "",
            kehadiran: ""
        };

        // Kuis Answer Keys (20 Questions)
        const kuisAnswers = {
            kq1: 'B', kq2: 'A', kq3: 'B', kq4: 'C', kq5: 'B',
            kq6: 'A', kq7: 'B', kq8: 'C', kq9: 'A', kq10: 'B',
            kq11: 'B', kq12: 'B', kq13: 'B', kq14: 'B', kq15: 'A',
            kq16: 'B', kq17: 'A', kq18: 'B', kq19: 'B', kq20: 'B'
        };

        // Latihan Answer Keys (5 Questions)
        const latihanAnswers = {
            lq1: 'B', lq2: 'B', lq3: 'A', lq4: 'B', lq5: 'A'
        };

        // Tab Switching Logic
        function switchTab(tabId) {
            // Hide all tab contents
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => content.classList.add('hidden'));

            // Remove active style from all tab buttons
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => btn.classList.remove('active'));

            // Show selected content and activate button
            const activeContent = document.getElementById('sec-' + tabId);
            const activeBtn = document.getElementById('tab-' + tabId);

            if (activeContent) activeContent.classList.remove('hidden');
            if (activeBtn) activeBtn.classList.add('active');

            // Scroll to top of main content
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Custom Alert Display Helper
        function showAlert(message, type = 'info') {
            const alertBox = document.getElementById('alertBox');
            const alertContent = document.getElementById('alertContent');
            const alertIcon = document.getElementById('alertIcon');

            alertBox.className = 'mb-6 p-4 rounded-xl border shadow-md flex items-start justify-between transition-all ';
            
            if (type === 'success') {
                alertBox.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-900');
                alertIcon.className = 'fa-solid fa-circle-check text-xl text-emerald-600 mr-3 mt-0.5';
            } else if (type === 'error') {
                alertBox.classList.add('bg-rose-50', 'border-rose-200', 'text-rose-900');
                alertIcon.className = 'fa-solid fa-circle-xmark text-xl text-rose-600 mr-3 mt-0.5';
            } else {
                alertBox.classList.add('bg-amber-50', 'border-amber-200', 'text-amber-900');
                alertIcon.className = 'fa-solid fa-circle-info text-xl text-amber-600 mr-3 mt-0.5';
            }

            alertContent.innerHTML = message;
            alertBox.classList.remove('hidden');
        }

        function closeAlert() {
            document.getElementById('alertBox').classList.add('hidden');
        }

        // User Identity Handler
        function updateBadgeUI() {
            const userBadge = document.getElementById('userBadge');
            if (currentUser.nama && currentUser.kelas) {
                document.getElementById('badgeName').textContent = currentUser.nama;
                document.getElementById('badgeClass').textContent = currentUser.kelas;
                userBadge.classList.remove('hidden');
            } else {
                userBadge.classList.add('hidden');
            }
        }

        function editUserIdentity() {
            switchTab('presensi');
            showAlert("Silakan perbarui data presensi Anda di bawah ini.", "info");
        }

        // Send Data to Google Apps Script Endpoint via GET Image/fetch fallback
        async function sendToAppsScript(payload) {
            try {
                const queryParams = new URLSearchParams(payload).toString();
                const fullUrl = `${APPS_SCRIPT_URL}?${queryParams}`;

                // Using no-cors fetch to prevent CORS blocking issues in iframe/preview
                await fetch(fullUrl, {
                    method: 'GET',
                    mode: 'no-cors'
                });
                return true;
            } catch (error) {
                console.error("Gagal menyambung ke Apps Script:", error);
                return false;
            }
        }

        // 1. Submit Presensi
        async function handlePresensiSubmit(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSubmitPresensi');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim Data...</span>`;

            currentUser.nama = document.getElementById('inputNama').value.trim();
            currentUser.kelas = document.getElementById('inputKelas').value;
            currentUser.kehadiran = document.getElementById('inputKehadiran').value;

            updateBadgeUI();

            const payload = {
                nama: currentUser.nama,
                kelas: currentUser.kelas,
                kehadiran: currentUser.kehadiran
            };

            await sendToAppsScript(payload);

            btn.disabled = false;
            btn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> <span>Kirim Presensi & Mulai Belajar</span>`;

            document.getElementById('presensiSuccessInfo').classList.remove('hidden');
            showAlert(`Presensi berhasil disimpan! Selamat belajar, <strong>${currentUser.nama}</strong> (${currentUser.kelas}).`, 'success');
        }

        // 2. Submit Latihan Soal
        async function handleLatihanSubmit(event) {
            event.preventDefault();
            if (!currentUser.nama || !currentUser.kelas) {
                showAlert("Harap isi data Presensi & Profil terlebih dahulu sebelum mengirimkan latihan soal!", "error");
                switchTab('presensi');
                return;
            }

            const form = document.getElementById('formLatihan');
            const formData = new FormData(form);
            let correctCount = 0;
            const totalQuestions = Object.keys(latihanAnswers).length;

            for (let [q, ans] of Object.entries(latihanAnswers)) {
                if (formData.get(q) === ans) {
                    correctCount++;
                }
            }

            const score = Math.round((correctCount / totalQuestions) * 100);
            document.getElementById('skorLatihanText').textContent = score;

            const btn = document.getElementById('btnSubmitLatihan');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim Nilai Latihan...</span>`;

            const payload = {
                nama: currentUser.nama,
                kelas: currentUser.kelas,
                kehadiran: currentUser.kehadiran || "Hadir",
                latihan: score
            };

            await sendToAppsScript(payload);

            btn.disabled = false;
            btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> <span>Hitung Nilai & Kirim Ke Server</span>`;

            showAlert(`Nilai Latihan Anda: <strong>${score}/100</strong> (Benar ${correctCount} dari ${totalQuestions} soal). Data berhasil dikirim ke spreadsheet!`, 'success');
        }

        // 3. Submit Kuis Evaluasi
        async function handleKuisSubmit(event) {
            event.preventDefault();
            if (!currentUser.nama || !currentUser.kelas) {
                showAlert("Harap isi data Presensi & Profil terlebih dahulu sebelum mengirimkan kuis evaluasi!", "error");
                switchTab('presensi');
                return;
            }

            const form = document.getElementById('formKuis');
            const formData = new FormData(form);
            let correctCount = 0;
            const totalQuestions = Object.keys(kuisAnswers).length;

            for (let [q, ans] of Object.entries(kuisAnswers)) {
                if (formData.get(q) === ans) {
                    correctCount++;
                }
            }

            const finalScore = Math.round((correctCount / totalQuestions) * 100);
            
            document.getElementById('skorKuisText').textContent = finalScore;
            document.getElementById('kuisResultBadge').classList.remove('hidden');

            const btn = document.getElementById('btnSubmitKuis');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim Nilai Akhir...</span>`;

            const payload = {
                nama: currentUser.nama,
                kelas: currentUser.kelas,
                kehadiran: currentUser.kehadiran || "Hadir",
                nilai: finalScore
            };

            await sendToAppsScript(payload);

            btn.disabled = false;
            btn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> <span>Selesaikan 20 Soal Kuis & Simpan Nilai Akhir</span>`;

            showAlert(`Evaluasi Selesai! Nilai Akhir Kuis Anda: <strong>${finalScore}</strong> (Benar ${correctCount} dari ${totalQuestions} soal). Nilai telah dicatat ke kolom NILAI AKHIR spreadsheet.`, 'success');
        }

        // Initialize on Load
        window.onload = function() {
            switchTab('presensi');
        };
    </script>
</body>
</html>
